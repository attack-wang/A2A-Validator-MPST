      "result": "main.py\n```python\n\"\"\"Gomoku - entry point and game loop.\"\"\"\nfrom board import Board\n\n\ndef parse_move(text, size):\n    \"\"\"Parse 'row col' input; return (r, c) or None if invalid.\"\"\"\n    parts = text.strip().replace(\",\", \" \").split()\n    if len(parts) != 2:\n        return None\n    try:\n        r, c = int(parts[0]), int(parts[1])\n    except ValueError:\n        return None\n    if 0 <= r < size and 0 <= c < size:\n        return r, c\n    return None\n\n\ndef main():\n    board = Board()\n    players = {1: \"Black (X)\", 2: \"White (O)\"}\n    current = 1\n\n    print(\"=== Gomoku (15x15) ===\")\n    print(\"Two players alternate: Black (X) and White (O).\")\n    print(\"Enter moves as 'row col' using indices 0-14, e.g. '7 7'.\")\n    print(\"Type 'q' to quit. First to align 5 stones wins.\")\n    print(board.render())\n\n    while True:\n        name = players[current]\n        try:\n            raw = input(f\"{name}, your move (row col): \")\n        except (EOFError, KeyboardInterrupt):\n            print(\"\\nGame aborted.\")\n            return\n        raw = raw.strip().lower()\n        if raw in (\"q\", \"quit\", \"exit\"):\n            print(\"Game aborted.\")\n            return\n\n        move = parse_move(raw, board.size)\n        if move is None:\n            print(\"Invalid input. Use two integers 0-14, e.g. '7 7'.\")\n            continue\n        r, c = move\n        if not board.is_empty(r, c):\n            print(\"Cell occupied. Choose another.\")\n            continue\n\n        board.place(r, c, current)\n        print(board.render())\n\n        if board.check_win(r, c, current):\n            print(f\"*** {name} wins! ***\")\n            return\n        if board.is_full():\n            print(\"Draw - the board is full.\")\n            return\n        current = 3 - current\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\nboard.py\n```python\n\"\"\"Gomoku board: state, placement, win detection, rendering.\"\"\"\n\nSIZE = 15\nEMPTY, BLACK, WHITE = 0, 1, 2\nSYMBOLS = {EMPTY: \".\", BLACK: \"X\", WHITE: \"O\"}\nDIRECTIONS = ((0, 1), (1, 0), (1, 1), (1, -1))  # H, V, diag \\, diag /\n\n\nclass Board:\n    def __init__(self, size=SIZE):\n        self.size = size\n        self.grid = [[EMPTY] * size for _ in range(size)]\n\n    def in_bounds(self, r, c):\n        return 0 <= r < self.size and 0 <= c < self.size\n\n    def is_empty(self, r, c):\n        return self.grid[r][c] == EMPTY\n\n    def place(self, r, c, player):\n        self.grid[r][c] = player\n\n    def is_full(self):\n        return all(cell != EMPTY for row in self.grid for cell in row)\n\n    def check_win(self, r, c, player):\n        \"\"\"True if the stone at (r, c) completes a line of 5+ for player.\"\"\"\n        for dr, dc in DIRECTIONS:\n            count = 1\n            for sign in (1, -1):\n                nr, nc = r + dr * sign, c + dc * sign\n                while self.in_bounds(nr, nc) and self.grid[nr][nc] == player:\n                    count += 1\n                    nr += dr * sign\n                    nc += dc * sign\n            if count >= 5:\n                return True\n        return False\n\n    def render(self):\n        header = \"    \" + \" \".join(f\"{c:2d}\" for c in range(self.size))\n        lines = [header]\n        for r in range(self.size):\n            row = \" \".join(f\"{SYMBOLS[v]:>2}\" for v in self.grid[r])\n            lines.append(f\"{r:2d} {row}\")\n        return \"\\n\".join(lines)\n```"
    },
