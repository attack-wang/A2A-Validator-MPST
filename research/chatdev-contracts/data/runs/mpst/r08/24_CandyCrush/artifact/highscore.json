def find_matches(self):
    runs = []
    # horizontal
    for r in range(rows):
        c = 0
        while c < cols:
            candy = grid[r][c]
            if candy is None or candy.type_idx < 0:  # None or bomb (type -1)
                c += 1; continue
            c2 = c + 1
            while c2 < cols and grid[r][c2] is not None and grid[r][c2].type_idx == candy.type_idx:
                c2 += 1
            if c2 - c >= 3:
                runs.append({'cells': [(r, cc) for cc in range(c, c2)], 'dir': 'h', 'len': c2-c})
            c = c2
    # vertical similar
    return runs